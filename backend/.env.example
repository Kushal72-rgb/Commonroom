# Local development defaults. Replace placeholders before using production.
NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/commonroom
CORS_ORIGIN=http://127.0.0.1:5500,http://localhost:5500
JWT_SECRET=REPLACE_WITH_A_RANDOM_SECRET_AT_LEAST_32_BYTES
JWT_EXPIRES_IN=1h
RESOURCE_LOCK_LEASE_MS=60000

# For MongoDB Atlas, use the provider-generated mongodb+srv URI as MONGODB_URI.
# Keep credentials out of this file and URL-encode special characters in passwords.
